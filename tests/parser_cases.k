# 优先级、括号、左结合、比较、嵌套调用、空调用、变量和小数。
1 + 2 * 3;
(1 + 2) * 3;
10 - 3 - 2;
1 + 2 < 3 * 4;
foo(1, bar(2 + 3), x);
empty();
x;
12.5;

# 一元负号优先级、递归、二元减法、函数调用和变量。
-2;
1 + -2;
1 * -2;
-(1 + 2) * 3;
--2;
1--2;
-foo(1, 2);
foo(-1, --2);
-x * y;
x < -y;

def combine(x y) x + y * 2;
extern clock();
extern foo(a b);
def neg(x) -x;
